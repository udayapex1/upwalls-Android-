{
  "expo": {
    "name": "up-walls",
    "slug": "up-walls",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/upwallsLogo.png",
    "scheme": "upwalls",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.upwalls"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/upwallsLogo.png",
        "backgroundImage": "./assets/images/upwallsLogo.png",
        "monochromeImage": "./assets/images/upwallsLogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.anonymous.upwalls"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/upwallsLogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "photo"
          ],
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save wallpapers to your photos."
        }
      ],
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuoteWidget",
              "label": "UpWalls Quote",
              "description": "A rotating quote from UpWalls",
              "minWidth": "250dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 14400000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9994e86e-96ea-490d-886c-e7cccaa994ce"
      }
    }
  }
}
